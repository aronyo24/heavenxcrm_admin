# Production build of the Control Center (npm run build).
# The app on dev.heavenxcrm.com calls the Django API directly on uapi.
# Backend .env must have: CONTROL_HOSTS=dev.heavenxcrm.com,uapi.heavenxcrm.com
#                         CONTROL_FRONTEND_URLS=https://dev.heavenxcrm.com
VITE_API_BASE_URL=https://uapi.heavenxcrm.com/api
VITE_TENANT_BASE_DOMAIN=heavenxcrm.com
