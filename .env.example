# heavenxcrm_admin - Developer Control Center
# Values are baked into the build: rebuild after changing.

# Where the Django API lives. Production: https://uapi.heavenxcrm.com/api
# (backend CONTROL_HOSTS must include uapi.heavenxcrm.com and
# CONTROL_FRONTEND_URLS must include this app's URL).
# Leave empty to call /api on this app's own host (Vite dev proxy locally,
# or an Apache ProxyPass /api/ on the Control Center vhost).
# Never point this at a company's own subdomain.
VITE_API_BASE_URL=

# Shown when creating a company: <subdomain>.<this>
VITE_TENANT_BASE_DOMAIN=heavenxcrm.com
